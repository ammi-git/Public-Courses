# Copier ce fichier en .env (jamais commité) puis choisir UNE option.

# --- Option A : LLM local avec Ollama (gratuit) ---
# ollama pull qwen2.5:7b        (16 Go de RAM conseillés)
# ollama pull qwen2.5:3b        (machine plus modeste : remplacer LLM_MODEL)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# --- Option B : API avec un compte personnel ---
# Tout fournisseur compatible OpenAI (OpenAI, Mistral, Groq, OpenRouter...).
# Pensez à activer un plafond de dépense sur votre compte.
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=votre-cle
# LLM_MODEL=mistral-small-latest

# --- Séances 4 et 7 (optionnel) : second modèle pour comparer local et API ---
# LLM2_BASE_URL=https://api.mistral.ai/v1
# LLM2_API_KEY=votre-cle
# LLM2_MODEL=mistral-small-latest

# --- Séances 3 à 7 : moteur d'embeddings ---
# Par défaut : sentence-transformers (PyTorch). Sur Mac Intel, utiliser Ollama :
#   ollama pull paraphrase-multilingual
# EMBEDDING_BACKEND=ollama
