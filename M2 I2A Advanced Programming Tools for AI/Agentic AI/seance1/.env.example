# Copier ce fichier en .env (jamais commité) puis choisir UNE option.

# --- Option A : LLM local avec Ollama (gratuit) ---
# ollama pull qwen3:8b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# --- Option B : API avec un compte personnel ---
# Tout fournisseur compatible OpenAI (OpenAI, Mistral, Groq, OpenRouter...).
# Pensez à activer un plafond de dépense sur votre compte.
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=votre-cle
# LLM_MODEL=mistral-small-latest

# --- Séance 4 : traces Langfuse (optionnel) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
